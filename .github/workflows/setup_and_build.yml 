name: 🚀 Setup Shield & Build APK

on:
  workflow_dispatch:
  push:
    paths:
      - 'setup_project.py'

jobs:
  setup-and-build:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      # 1. تنزيل المستودع
      - name: 📥 Checkout repository
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

      # 2. إعداد Python
      - name: 🐍 Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      # 3. تشغيل السكريبت لإنشاء كل الملفات
      - name: 🏗️ Generate all project files
        run: python setup_project.py

      # 4. توليد Gradle Wrapper (ضروري للبناء)
      - name: 📦 Generate Gradle Wrapper
        run: |
          curl -sL https://services.gradle.org/distributions/gradle-8.2-bin.zip -o /tmp/gradle.zip
          unzip -q /tmp/gradle.zip -d /tmp/
          /tmp/gradle-8.2/bin/gradle wrapper --gradle-version 8.2
          chmod +x gradlew
          echo "✅ Gradle wrapper generated"

      # 5. رفع الملفات الجديدة إلى المستودع (commit)
      - name: 💾 Commit generated files
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add .
          git diff --staged --quiet || git commit -m "🎉 Auto-generate Shield project files"
          git push
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      # 6. إعداد JDK
      - name: ☕ Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'
          cache: 'gradle'

      # 7. بناء APK
      - name: 🔨 Build Debug APK
        run: ./gradlew assembleDebug --no-daemon --stacktrace

      # 8. تجهيز artifact
      - name: 📤 Prepare APK artifact
        run: |
          mkdir -p artifacts
          cp app/build/outputs/apk/debug/app-debug.apk artifacts/Shield-v1.0.0-debug.apk
          echo "✅ APK ready: $(ls -lh artifacts/)"

      # 9. رفع APK
      - name: 🎁 Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Shield-APK
          path: artifacts/Shield-v1.0.0-debug.apk
          retention-days: 30
          if-no-files-found: error
